NODE_ENV=development
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/task_service

# Telegram connection string
TELEGRAM_BOT_TOKEN=...

# API key for authentication (change this in production!)
TASK_SERVICE_API_KEY=change-this-secret

# Default timezone for users
DEFAULT_TIMEZONE=Asia/Makassar

# Reminder scheduler interval in seconds (default: 60)
REMINDER_INTERVAL_SECONDS=60

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS - comma-separated allowed origins (empty = allow all in development)
CORS_ORIGINS=
